{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simvariant",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "OFFICE", "class_name": "Office" }],
    // Kontoret går aldrig i viloläge (simuleringen tickar och WebSockets är öppna),
    // så uppskjutna kodbyten skulle bara fördröja nya versioner. Byt direkt i stället.
    "code_update_strategy": { "mode": "immediate" }
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Office"] }]
}
