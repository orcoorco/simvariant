# SimVariant – valfri LLM-koppling.
# Utan nyckel kör spelet på den inbyggda lokala AI-motorn (fullt spelbart).
# Kopiera till .env (eller .dev.vars) och fyll i EN av nycklarna nedan.

# Google Gemini
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# …eller Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Tvinga leverantör om båda nycklarna finns: google | anthropic | none
# LLM_PROVIDER=
